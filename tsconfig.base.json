{
  "extends": "@org/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "customConditions": ["@org/source"],
    "noUncheckedSideEffectImports": false,
    "types": ["*"]
  }
}
