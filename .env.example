# Production environment template.
#
# Copy to .env, fill every REQUIRED value, then check it:
#
#   docker compose --env-file .env config
#
# That command must succeed before `bun run docker:prod`. compose.yaml has no
# production defaults for secrets or public URLs, so a missing value fails the
# config step instead of shipping a dev credential or a localhost URL.
#
# Development uses .env.example.dev. The two files are deliberately separate so
# a development default can never reach production.
#
# Nothing here is baked into an image (.dockerignore excludes env files).

# --- Database -------------------------------------------------------------
POSTGRES_USER=app
# REQUIRED. Use a long random value, different from POSTGRES_APP_PASSWORD.
POSTGRES_PASSWORD=
POSTGRES_DB=app

# Unprivileged role for tenant queries. Row level security is only enforced
# for this role, so DATABASE_APP_URL must never point at POSTGRES_USER.
POSTGRES_APP_USER=app_tenant
# REQUIRED. Use a long random value, different from POSTGRES_PASSWORD.
POSTGRES_APP_PASSWORD=

#----- Database pool (postgres-js)
DB_POOL_MAX=10

# --- Published ports ------------------------------------------------------
WEB_PORT=3000
API_PORT=3001

# --- Client-visible API URL ----------------------------------------------
# REQUIRED. Vite inlines it into the client bundle at build time, so changing
# it requires a rebuild. It must be the public API origin and must share the
# registrable domain with WEB_URL, for example app.example.com and
# api.example.com. A different registrable domain makes the session cookie
# cross-site and the browser drops it.
VITE_API_URL=

#----- Better Auth
# REQUIRED. Public URL of the API.
BETTER_AUTH_URL=
# REQUIRED. Public URL of the web app.
WEB_URL=
# REQUIRED. Long random string. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

#----- Social providers (Better Auth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#----- SMTP (Nodemailer) for transactional email
# Set these for production email delivery. Verification, reset, magic-link and
# invitation messages all use this transport.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Redis ---------------------------------------------------------------
# Used by Better Auth and BullMQ. The compose service is internal only.
REDIS_URL=redis://redis:6379
# Optional. Only set this if the Redis deployment requires authentication.
REDIS_PASSWORD=

# --- Realtime WebSocket --------------------------------------------------
# Server side liveness probe. Keep it below the idle timeout of any proxy in
# front of the API, otherwise a quiet socket is dropped by the proxy first.
REALTIME_PING_INTERVAL_MS=25000
# A connection reconnects at most this often. This is what re-checks a session
# or a membership that changed while the socket was open.
REALTIME_MAX_CONNECTION_MS=1800000
# Inbound frame guard rails. These protect the process from a broken client.
REALTIME_MAX_FRAME_BYTES=16384
REALTIME_MAX_FRAMES_PER_SECOND=20

# --- S3-compatible object storage (SeaweedFS) ----------------------------
# Endpoint is the compose service name inside the network.
S3_ENDPOINT=http://seaweedfs:8333
# REQUIRED. Browser reachable reverse proxy in front of SeaweedFS. It must
# preserve the Host header, because the host is part of the SigV4 signature.
S3_PUBLIC_ENDPOINT=
# REQUIRED. Exact web origin(s) allowed to call the S3 gateway from a browser.
S3_ALLOWED_ORIGINS=
# REQUIRED. Used by both the API and the SeaweedFS config written at start.
# Use strong values, different from the development admin/admin pair.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=handoff
S3_REGION=us-east-1
S3_USE_SSL=false
