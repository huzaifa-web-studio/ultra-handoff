# Copy to .env (production) or .env.dev (development) and adjust.
# The compose scripts pass the matching file via --env-file.
# Nothing here is ever baked into an image (.dockerignore excludes env files).

# --- Database -------------------------------------------------------------
# Must match the POSTGRES_* values below. The host is the compose service
# name, not localhost — inside a container the app talks over the compose
# network. The compose files build DATABASE_URL from these for you.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Unprivileged role for tenant queries. Row level security is only enforced
# for this role, so DATABASE_APP_URL must never point at POSTGRES_USER.
# The compose files build DATABASE_APP_URL from these two values.
POSTGRES_APP_USER=app_tenant
POSTGRES_APP_PASSWORD=tenant

#----- Database pool (postgres-js)
DB_POOL_MAX=10

# --- Published ports ------------------------------------------------------
WEB_PORT=3000
API_PORT=3001
# Only published by compose.dev.yaml.
POSTGRES_PORT=5432
REDIS_PORT=6379
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_MASTER_PORT=9333
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
REDIS_INSIGHT_PORT=5540
DB_STUDIO_PORT=4983

# --- Client-visible API URL ----------------------------------------------
# Baked into the web client bundle at build time, so changing it requires a
# rebuild. Leave empty to use same-origin / relative requests.
VITE_API_URL=

#----- Better Auth
BETTER_AUTH_URL= #url of a backend
WEB_URL= #url of a frontend
BETTER_AUTH_SECRET= #random strong string

#----- Social providers (Better Auth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#----- SMTP (Nodemailer) for transactional email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Handoff <[email protected]>

# --- Redis ---------------------------------------------------------------
# Used by Better Auth and BullMQ. Leave REDIS_PASSWORD empty for no auth (dev only).
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# --- S3-compatible object storage (SeaweedFS) ----------------------------
# Endpoint is the compose service name inside the network.
S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin
S3_BUCKET=handoff
S3_REGION=us-east-1
S3_USE_SSL=false
