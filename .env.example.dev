# Development environment template.
#
# Copy to .env.dev, then run:
#
#   bun run docker:dev
#
# compose.dev.yaml keeps development defaults for every value, so this file is
# mostly about pointing at the dev services (Mailpit, the published SeaweedFS
# ports, localhost URLs). Production uses .env.example instead.
#
# Nothing here is baked into an image (.dockerignore excludes env files).

# --- Database -------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Unprivileged role for tenant queries. Row level security is only enforced
# for this role.
POSTGRES_APP_USER=app_tenant
POSTGRES_APP_PASSWORD=tenant

#----- Database pool (postgres-js)
DB_POOL_MAX=10

# --- Published ports ------------------------------------------------------
WEB_PORT=3000
# Published on loopback only. Bull Board and OpenAPI are unauthenticated in
# development.
API_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_MASTER_PORT=9333
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
REDIS_INSIGHT_PORT=5540
DB_STUDIO_PORT=4983

# --- Client-visible API URL ----------------------------------------------
# Leave empty in development. The web client falls back to
# http://localhost:3001 when VITE_API_URL is unset.
VITE_API_URL=

#----- Better Auth
BETTER_AUTH_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# Development only. Production requires a real random secret.
BETTER_AUTH_SECRET=dev-only-change-me

#----- Social providers (Better Auth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#----- SMTP (Nodemailer) for transactional email
# Mailpit captures everything locally. Open http://localhost:8025.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Handoff <[email protected]>

# --- Redis ---------------------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# --- Realtime WebSocket --------------------------------------------------
REALTIME_PING_INTERVAL_MS=25000
REALTIME_MAX_CONNECTION_MS=1800000
REALTIME_MAX_FRAME_BYTES=16384
REALTIME_MAX_FRAMES_PER_SECOND=20

# --- S3-compatible object storage (SeaweedFS) ----------------------------
S3_ENDPOINT=http://seaweedfs:8333
# Browser facing endpoint. In development this is the published host port.
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_ALLOWED_ORIGINS=http://localhost:3000
# Development only. Production requires real credentials.
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin
S3_BUCKET=handoff
S3_REGION=us-east-1
S3_USE_SSL=false
