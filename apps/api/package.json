{
  "name": "@org/api",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --compile --minify --sourcemap --bytecode --outfile dist/api ./src/index.ts",
    "start": "bun run src/index.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "db:generate": "drizzle-kit generate",
    "db:bootstrap": "bun run scripts/bootstrap-db.ts",
    "db:setup": "bun run db:bootstrap && bun run db:migrate",
    "db:verify-rls": "bun run scripts/verify-rls.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "email": "email dev --dir src/emails"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@bull-board/api": "^9.10.4",
    "@bull-board/elysia": "^9.10.4",
    "@bull-board/ui": "^9.10.4",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@react-email/components": "^1.0.12",
    "better-auth": "^1.7.11",
    "bullmq": "^6.3.18",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.1.7",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@org/biome-config": "workspace:*",
    "@org/tsconfig": "workspace:*",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.3",
    "drizzle-kit": "^0.31.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.3"
  },
  "types": "src/index.ts",
  "module": "src/index.js"
}
