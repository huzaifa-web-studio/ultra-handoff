{
  "name": "api",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --compile --minify --sourcemap --bytecode --outfile dist/api ./src/index.ts",
    "start": "bun run src/index.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@org/biome-config": "workspace:*",
    "@org/tsconfig": "workspace:*",
    "bun-types": "^1.4.3",
    "drizzle-kit": "^0.31.11"
  },
  "module": "src/index.js"
}
