{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "projectType": "application",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bunx tsc --noEmit -p tsconfig.json"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "docker:build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "docker build -f apps/api/Dockerfile -t ultra-api:latest ."
      }
    },
    "docker:up": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "docker compose -f compose.dev.yaml up -d --build api"
      }
    },
    "docker:down": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "docker compose -f compose.dev.yaml down"
      }
    }
  }
}
