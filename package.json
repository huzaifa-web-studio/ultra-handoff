{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "docker:prod": "docker compose --env-file .env up -d --build",
    "docker:prod:down": "docker compose --env-file .env down",
    "docker:prod:logs": "docker compose --env-file .env logs -f",
    "docker:dev": "docker compose --env-file .env.dev -f compose.dev.yaml up --build --watch",
    "docker:dev:down": "docker compose --env-file .env.dev -f compose.dev.yaml down",
    "docker:dev:logs": "docker compose --env-file .env.dev -f compose.dev.yaml logs -f",
    "db:generate": "cd apps/api && bun run db:generate",
    "db:migrate": "cd apps/api && bun run db:migrate",
    "db:studio": "docker compose --env-file .env.dev -f compose.dev.yaml exec api bun run db:studio"
  },
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "@nx/js": "23.2.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "nx": "23.2.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "@biomejs/biome": "2.4.5",
    "@org/biome-config": "workspace:*",
    "@org/tsconfig": "workspace:*"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
